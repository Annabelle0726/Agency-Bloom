{
  "$schema": "https://opencode.ai/config.json",
  // The local Agency Bloom API uses vLLM's default port (8000) but is not an
  // OpenAI-compatible model server. Disable vLLM discovery so OpenCode does not
  // probe /health and /v1/models against it in this project.
  "plugins": ["-opencode.provider.vllm"]
}
