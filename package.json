{
  "name": "agency-bloom",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --prefix apps/miniprogram run dev:preview",
    "dev:mp": "npm --prefix apps/miniprogram run dev:mp-weixin",
    "dev:wechat": "node tools/wechat.mjs dev",
    "wechat:open": "node tools/wechat.mjs open dev",
    "wechat:open:build": "node tools/wechat.mjs open build",
    "test:tools": "node --test tools/wechat.test.mjs tools/evaluation-fixtures.test.mjs",
    "visuals:sync": "node tools/sync-visual-manifest.cjs",
    "visuals:validate": "node tools/validate-visual-manifest.cjs",
    "visuals:sheets": "node tools/generate-visual-contact-sheets.cjs",
    "check:visuals": "node tools/sync-visual-manifest.cjs --check && node tools/validate-visual-manifest.cjs",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8000",
    "test:api": "uv run --directory apps/api pytest",
    "test:ui": "npm --prefix apps/miniprogram test",
    "build:mp": "npm --prefix apps/miniprogram run build:mp-weixin && node tools/finalize-mp-media.cjs build && node tools/check-wechat.mjs build --if-available",
    "check:mp": "node tools/check-wechat.mjs build",
    "check:mp:dev": "node tools/check-wechat.mjs dev",
    "check:mp:watch": "node tools/verify-wechat-watch.mjs",
    "typecheck": "npm --prefix apps/miniprogram run typecheck",
    "db:link": "supabase link --project-ref ycombbpglsmbvjlrjtgc",
    "lint:api": "uv run --directory apps/api ruff check app tests",
    "visuals:storage": "node tools/prepare-visual-storage.cjs",
    "test:visuals": "node --test tools/ingest-visual-library.test.mjs tools/prepare-visual-storage.test.mjs tools/prune-visual-cloud-build.test.cjs tools/source-archive.test.cjs tools/check-mp-media.test.cjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2"
  }
}
