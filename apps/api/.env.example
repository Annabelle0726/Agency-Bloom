# Copy to .env. Local development works with no external credentials.
AGENCY_ENVIRONMENT=development
AGENCY_DATABASE_URL=sqlite:///./agency.db
AGENCY_ALLOW_DEV_AUTH=true
AGENCY_AI_MODE=demo

# Put only a NEW, rotated API key here. Never place it in a VITE_ variable.
AGENCY_DEEPSEEK_API_KEY=
AGENCY_DEEPSEEK_MODEL=deepseek-flash
AGENCY_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENCY_AI_MONTHLY_BUDGET_CNY=20
AGENCY_DAILY_CHAT_LIMIT=30
# Official CNY peak rates per million tokens, checked 2026-10-17.
# Reserve cache-miss peak prices; settle actual cache usage and off-peak pricing.
AGENCY_INPUT_PRICE_PER_MILLION=2
AGENCY_OUTPUT_PRICE_PER_MILLION=8
AGENCY_CACHED_INPUT_PRICE_PER_MILLION=0.04
AGENCY_OFFPEAK_PRICE_MULTIPLIER=0.5
AGENCY_MAX_OUTPUT_TOKENS=768
# Optional verified Chinese public-holiday dates (otherwise weekday peak is a ceiling).
AGENCY_DEEPSEEK_OFFPEAK_DATES=[]

AGENCY_WECHAT_APP_ID=
AGENCY_WECHAT_APP_SECRET=
AGENCY_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Supabase: copy the session-pooler connection from your project's Connect panel.
# SQLAlchemy uses postgresql+psycopg://. URL-encode the password; sslmode=require.
# AGENCY_DATABASE_URL=postgresql+psycopg://postgres.ycombbpglsmbvjlrjtgc:ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
